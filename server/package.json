{
  "name": "@ottodot/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "serve": "node dist/server.js",
    "migrate": "node ./database/migrate.js",
    "migrate:deploy": "node ./database/migrate.js deploy --yes",
    "migrate:status": "node ./database/migrate.js status",
    "migrate:fresh": "node ./database/fresh.js",
    "demo:last-seat": "tsx src/scripts/demo-last-seat.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
